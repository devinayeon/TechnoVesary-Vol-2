APP_NAME=ReValue
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://revalue.kodetalma.my.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Logging Docker
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database Docker (Service "db" di compose.prod.yml)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=revalue
DB_USERNAME=revalue
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Session HTTPS
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Email SMTP (Gmail)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="no-reply@revalue.kodetalma.my.id"
MAIL_FROM_NAME="${APP_NAME}"

# Midtrans Payment Gateway
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_IS_SANITIZED=true
MIDTRANS_IS_3DS=true

INERTIA_SSR_ENABLED=false
VITE_APP_NAME="${APP_NAME}"

# OpenStreetMap (OSM) & OSRM Configuration
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_PROFILE=driving
OSRM_TIMEOUT=10

NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT="ReValue-BankSampah/1.0 (admin@revalue.kodetalma.my.id)"
NOMINATIM_TIMEOUT=10

OSM_CACHE_ENABLED=true
OSM_CACHE_TTL=86400

MAP_DEFAULT_LATITUDE=-6.2088
MAP_DEFAULT_LONGITUDE=106.8456
MAP_DEFAULT_ZOOM=13

BASEMAP_API_KEY=
VITE_BASEMAP_API_KEY=

# Image Docker GHCR
IMAGE_NAME=ghcr.io/tunggulalmajid/technovesary-vol-2
IMAGE_TAG=latest
